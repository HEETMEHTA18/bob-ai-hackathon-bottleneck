# GridShield AI - Environment Configuration
# Copy this to .env and fill in your values
# GridShield works in DEMO MODE without any external credentials.

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite for dev/demo (no setup required)
# For production: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./gridmind.db

# ─── JWT Authentication (Gridkavach legacy) ──────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── AI Copilot ──────────────────────────────────────────────────────────────
# Optional: enables Gemini-powered Grid Operations Advisor
# Without this key the copilot uses deterministic fallback responses.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ─── GridShield ML ───────────────────────────────────────────────────────────
# Set to 1 to use the real XGBoost pipeline instead of MockFailurePredictor.
# Before setting this to 1, run the training pipeline:
#   python -m backend.gridshield.ml.data.generate_training_data
#   python -m backend.gridshield.ml.training.train_models
GRIDSHIELD_USE_REAL_ML=0

# Optional: override the directory where trained model artifacts are stored
# Default: <project_root>/models/gridshield/
# GRIDSHIELD_MODELS_DIR=/path/to/models/gridshield
