# GridShield AI - Environment Configuration
# Copy this to .env and fill in your values
# GridShield works in DEMO MODE without any external credentials.

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite for dev/demo (no setup required)
# For production: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./gridmind.db

# ─── JWT Authentication (Gridkavach legacy) ──────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Demo Mode (optional) ────────────────────────────────────────────────────
# If set, the frontend "Fill Demo" button will pre-fill the login form.
# Leave unset in production deployments where demo access is not desired.
# These are frontend env vars (VITE_ prefix) — they end up in the browser
# bundle.  Only set to a real account you are comfortable exposing publicly.
# The backend demo user is seeded at startup from main.py.
VITE_DEMO_EMAIL=demo@gridshield.ai
VITE_DEMO_PASSWORD=demo1234

# ─── AI Copilot ──────────────────────────────────────────────────────────────
# Optional: enables Gemini-powered Grid Operations Advisor
# Without this key the copilot uses deterministic fallback responses.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ─── GridShield ML ───────────────────────────────────────────────────────────
# 1 = use real XGBoost pipeline (models/bottleneck/bottleneck-failure-v2);
# 0 = deterministic mock predictor (demo fallback)
GRIDSHIELD_USE_REAL_ML=1
